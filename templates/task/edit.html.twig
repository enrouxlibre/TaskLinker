{% extends 'base.html.twig' %}

{% block title %}{{ task.name }} - TaskLinker{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/myselect.css') }}" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/myselect.js') }}" defer></script>
{% endblock %}

{% block header_title %}
    <h1>{{ task.name }}</h1>
{% endblock %}

{% block body %}
            <div id="content">
                {{ form_start(form, {'attr': {'name': 'tache'}}) }}
                    <div>
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div>
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description) }}
                        {{ form_errors(form.description) }}
                    </div>
                    <div class="flex-form">
                        <div>
                            {{ form_label(form.date) }}
                            {{ form_widget(form.date) }}
                            {{ form_errors(form.date) }}
                        </div>
                        <div>
                            {{ form_label(form.status) }}
                            {{ form_widget(form.status) }}
                            {{ form_errors(form.status) }}
                        </div>
                    </div>
                    <div>
                        {{ form_label(form.membre) }}
                        {{ form_widget(form.membre) }}
                        {{ form_errors(form.membre) }}
                    </div>
                    <br>
                    <button class="button button-submit">Modifier</button>
                    <a href="#" class="delete-task">Supprimer la tâche</a>
                {{ form_end(form) }}
            </div>

{% endblock %}
