{% extends 'base.html.twig' %}

{% block title %}Nouveau projet - TaskLinker{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/myselect.css') }}" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/myselect.js') }}" defer></script>
{% endblock %}

{% block header_title %}
    <h1>Nouveau projet</h1>
{% endblock %}

{% block body %}
            <div id="content">
                {{ form_start(form, {'attr': {'name': 'projet'}}) }}
                    <div>
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div>
                        {{ form_label(form.membres) }}
                        {{ form_widget(form.membres) }}
                        {{ form_errors(form.membres) }}
                    </div>
                    <br>
                    <button class="button button-submit">Continuer</button>
                {{ form_end(form) }}
            </div>

{% endblock %}
